# ═════════════════════════════════════════════════════════════════════════════
# Vectra — Docker Compose environment.  Copy to .env and fill in.
#   cp .env.example .env
# PLACEHOLDERS ONLY — never commit real secrets. .env is gitignored.
#
# Column key:  [where]   frontend = browser bundle | backend = server only
#              [when]    build = baked at image build | run = read at runtime
#              [secret]  YES = keep private | no = safe to expose
# ═════════════════════════════════════════════════════════════════════════════

# ── Firebase CLIENT SDK (browser) ────────────────────────────────────────────
# [frontend] [build] [secret: no — Firebase Web config is meant for the browser]
# From Firebase Console → Project Settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Frontend → backend routing ───────────────────────────────────────────────
# [frontend] [build] [secret: no]
# Leave EMPTY to use the same-origin /api/backend proxy (recommended for Docker).
# Set to an absolute URL only to bypass the proxy (browser calls backend directly).
NEXT_PUBLIC_API_URL=

# ── Firebase ADMIN SDK (backend) ─────────────────────────────────────────────
# [backend] [run] [secret: YES — this is a private key. NEVER use NEXT_PUBLIC_*]
# Inline service-account JSON. Raw JSON or base64 (single-line friendly):
#   base64 -w0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: mount the JSON file (see docker-compose.yml volumes) and set:
# FIREBASE_CREDENTIALS=/run/secrets/firebase-sa.json

# ── Cloud Security ───────────────────────────────────────────────────────────
# [backend] [run] [secret: YES] Required. 32 random bytes, base64:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VECTRA_SECRETS_KEY=
# [backend] [run] [secret: no] Optional — enables AWS "IAM role" connections.
VECTRA_AWS_PRINCIPAL_ARN=
# [backend] [run] [secret: no] Optional tuning.
CLOUD_SYNC_MAX_FINDINGS=25000

# ── CVE intelligence ─────────────────────────────────────────────────────────
# [backend] [run] [secret: YES] NVD API key (optional; raises rate limits).
NVD_API_KEY=
CVE_MODE=

# ── SAST repository OAuth ────────────────────────────────────────────────────
# [backend] [run] [secret: client secrets = YES]
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# [backend] [run] [secret: no] Used to build OAuth redirect URIs / links.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Email (team invitations) ─────────────────────────────────────────────────
# [backend] [run] [secret: SMTP_PASS = YES]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Scan execution tuning ────────────────────────────────────────────────────
# [backend] [run] [secret: no]
MAX_CONCURRENT_SCANS_PER_USER=1
MAX_NETWORK_WORKERS=5
QUICK_SCAN_TIMEOUT_SECS=900
FULL_SCAN_TIMEOUT_SECS=1800
STALE_SCAN_SECS=120
