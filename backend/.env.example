# Vectra backend configuration — copy to backend/.env and fill in.
# PLACEHOLDERS ONLY. Never commit real values.
#
# NOTE: In Docker, the backend does NOT read this file or backend/.env — those
# are dockerignored. Runtime values are injected by docker-compose.yml, which
# interpolates them from the ROOT .env file. Use backend/.env only for running
# the backend natively (uvicorn), where main.py loads it on startup.

# ── Firebase Admin (identity verification, Firestore) ────────────────
# Path to a service-account JSON kept OUTSIDE the repository.
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json
# Alternatives: FIREBASE_SERVICE_ACCOUNT_JSON (inline/base64) or FIREBASE_USE_ADC=true

# ── CVE intelligence ─────────────────────────────────────────────────
NVD_API_KEY=your_nvd_api_key_here
# local | nvd | hybrid (default: hybrid)
CVE_MODE=hybrid

# ── SAST repository OAuth ────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Email (team invitations) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Scan execution ───────────────────────────────────────────────────
MAX_CONCURRENT_SCANS_PER_USER=
MAX_NETWORK_WORKERS=
QUICK_SCAN_TIMEOUT_SECS=
FULL_SCAN_TIMEOUT_SECS=
STALE_SCAN_SECS=

# ── Cloud Security ───────────────────────────────────────────────────
# Required. 32 random bytes, base64. Encrypts stored provider credentials
# and derives each organization's AWS ExternalId. Changing it makes stored
# credentials unreadable (integrations must be reconnected).
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VECTRA_SECRETS_KEY=

# Optional. ARN of Vectra's own AWS principal, shown in customers' role trust
# policy. Enables "IAM role" connections. Vectra's credentials for that
# principal come from the standard AWS chain (instance/task role preferred;
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY only if no role is available).
VECTRA_AWS_PRINCIPAL_ARN=

# Optional tuning.
CLOUD_SYNC_MAX_FINDINGS=25000
